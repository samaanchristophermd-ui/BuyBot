{
  "name": "buybot",
  "productName": "BuyBot",
  "version": "2.0.0",
  "description": "Stock monitor and checkout assistant for Amazon, Best Buy, Target, Walmart and Costco.",
  "private": true,
  "license": "MIT",
  "author": "BuyBot contributors",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:electron": "electron test/electron/driver-smoke.js",
    "test:app": "node test/electron/app-e2e.js",
    "dist": "electron-builder --mac -c.directories.output=\"$HOME/BuyBot-build\"",
    "pack": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.buybot.app",
    "productName": "BuyBot",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "afterPack": "build/after-pack.js",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0"
  }
}
